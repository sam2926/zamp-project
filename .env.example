# Copy to .env and fill in ONE of these. .env is gitignored.

OPENAI_API_KEY=sk-proj-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults: gpt-4o-mini for OpenAI, claude-haiku-4-5 for Anthropic.
# Keep it cheap — the task is reading one name out of a short text.
# EXTRACTION_MODEL=gpt-4o-mini

# Optional. Force a provider when both keys are present: openai | anthropic
# LLM_PROVIDER=openai
